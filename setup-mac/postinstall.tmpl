#!/bin/bash
# Runs as root from Installer.app. The real work (agent LaunchAgent, app,
# config) belongs to the logged-in user, so hand off to them.
#
# The .pkg holds no token, so one file serves every user. The token comes from
# the link it was downloaded with (macOS keeps it in the kMDItemWhereFroms
# attribute: links with ?t=), else the user types it: that code decides which
# group of machines this Mac joins. Left empty on a Mac that already has
# RemoteDesk, the current code (group) is kept.
LOG=/tmp/remotedesk-install.log
SERVER='{{SERVER}}'
WITH_APP='{{WITH_APP}}'
PKG="$1"
U="$(stat -f%Su /dev/console)"
UIDN="$(id -u "$U")"
as_user() { launchctl asuser "$UIDN" sudo -u "$U" "$@"; }

TOKEN="$(xattr -px com.apple.metadata:kMDItemWhereFroms "$PKG" 2>/dev/null | xxd -r -p |
  LC_ALL=C tr -c 'A-Za-z0-9_%?&=./:-' '\n' | grep -o '[?&]t=[A-Za-z0-9_%-]\{20,\}' | head -1 | sed 's/^[?&]t=//')"
CFG="$(eval echo "~$U")/Library/Application Support/RemoteDesk/config.json"
if [ -z "$TOKEN" ]; then
  HAVE=""
  [ -f "$CFG" ] && HAVE="$(plutil -extract token raw -o - "$CFG" 2>/dev/null)"
  MSG="Nhập mã truy cập RemoteDesk (người quản trị đã gửi cho bạn).\nAi đăng nhập trang web bằng mã này sẽ xem và điều khiển được máy này."
  [ -n "$HAVE" ] && MSG="$MSG\n\nMáy này đã cài RemoteDesk: để trống để giữ nhóm máy hiện tại, nhập mã khác để chuyển sang nhóm đó."
  TOKEN="$(as_user osascript -e "text returned of (display dialog \"$MSG\" default answer \"\" buttons {\"Huỷ\", \"OK\"} default button \"OK\" cancel button \"Huỷ\" with title \"RemoteDesk\")" 2>/dev/null)" || exit 1
  TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]')"
  [ -z "$TOKEN" ] && TOKEN="$HAVE"
fi
TOKEN="$(printf '%s' "$TOKEN" | tr -d '[:space:]')"
echo "== $(date) installing for $U (token: $([ -n "$TOKEN" ] && echo found || echo missing))" >> "$LOG"
[ -z "$TOKEN" ] && exit 1

SCRIPT="$(mktemp /tmp/rd-install.XXXXXX)"
if ! curl -fsSL -H "Authorization: Bearer $TOKEN" "$SERVER/install.sh?app=$WITH_APP" -o "$SCRIPT" 2>> "$LOG"; then
  rm -f "$SCRIPT"
  as_user osascript -e 'display dialog "Không tải được bộ cài RemoteDesk: mã truy cập sai hoặc đã bị thu hồi, hoặc máy chưa có mạng." buttons {"OK"} default button "OK" with icon stop with title "RemoteDesk"' >/dev/null 2>&1
  exit 1
fi
chmod 755 "$SCRIPT"
launchctl asuser "$UIDN" sudo -u "$U" -H env PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
  /bin/bash "$SCRIPT" >> "$LOG" 2>&1
rc=$?
rm -f "$SCRIPT"
# Stay reachable: no system sleep while on the charger (display may still sleep).
pmset -c sleep 0 >> "$LOG" 2>&1 || true

# After a reboot the agent starts at login; without automatic login the Mac waits
# at the login window. Offer (not force) to open the setting.
if [ $rc -eq 0 ] && [ -z "$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)" ]; then
  ans="$(launchctl asuser "$UIDN" sudo -u "$U" osascript -e 'display dialog "RemoteDesk đã cài xong và sẽ tự chạy mỗi khi bạn đăng nhập.\n\nĐể máy tự chạy RemoteDesk cả sau khi khởi động lại (không cần ai đăng nhập), bật: Users & Groups › Automatically log in as.\n(Không dùng được nếu đang bật FileVault.)" buttons {"Để sau", "Mở cài đặt"} default button "Để sau" with title "RemoteDesk"' 2>/dev/null)"
  case "$ans" in *"Mở cài đặt"*) launchctl asuser "$UIDN" sudo -u "$U" open "x-apple.systempreferences:com.apple.Users-Groups-Settings.extension" ;; esac
fi

# First install (or new agent): show where to grant Screen Recording + Accessibility.
if [ $rc -eq 0 ] && tail -30 "$LOG" | grep -q "QUAN TRỌNG"; then
  launchctl asuser "$UIDN" sudo -u "$U" open "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture"
fi
exit $rc
